section.card
  p
    a(href="{% url 'timetable-detail' pk=timetable.pk %}" hx-get="{% url 'timetable-detail' pk=timetable.pk %}" hx-target="#panel" hx-push-url="true") #{timetable.name}
  h1 #{timetable.name} v#{version.number}
  include timetable/status.pug
  ol.steps
    li(class="{% if requirements %}done{% endif %}") Add requirements
    li(class="{% if ready %}done{% endif %}") Generate
    li(class="{% if ready %}done{% endif %}") Review timetable
    li(class="{% if version.status == 'published' %}done{% endif %}") Publish
  if version.reason
    p.muted= version.reason
  if notice
    p.flash.success= notice
  if error
    p.flash.error= error
  if violations
    div.flash.error
      strong Publishing blocked
      ul.errorlist
        each violation in violations
          li= violation
  if stale
    p.flash.warning The requirements changed after this timetable was generated. Press Generate timetable to update it.
  elif ready and version.status == 'draft'
    if can_publish
      p.flash.success The timetable is ready. Check it below, then publish it.
    else
      p.flash.success The timetable is ready. Check it below, then ask an administrator to publish it.
  div.row
    if can_generate
      form.inline(method="post" action="{% url 'version-solve' pk=version.pk %}" hx-post="{% url 'version-solve' pk=version.pk %}" hx-target="#panel")
        - csrf_token
        if ready
          button.secondary(type="submit") Generate again
        elif requirements
          button(type="submit") Generate timetable
        else
          button(type="submit" disabled) Generate timetable
      unless requirements
        span.muted Add at least one requirement below first.
    if can_reopen
      form.inline(method="post" action="{% url 'version-reopen' pk=version.pk %}" hx-post="{% url 'version-reopen' pk=version.pk %}" hx-target="#panel")
        - csrf_token
        button.secondary(type="submit") Reopen
  if can_publish and ready
    form.row(method="post" action="{% url 'version-publish' pk=version.pk %}" hx-post="{% url 'version-publish' pk=version.pk %}" hx-target="#panel")
      - csrf_token
      | {{ publish_form.as_div }}
      button(type="submit") Publish
  if others
    form.row(method="get" action="{% url 'version-compare' pk=version.pk %}" hx-get="{% url 'version-compare' pk=version.pk %}" hx-target="#panel" hx-push-url="true")
      label
        | Compare with
        select(name="other")
          each other in others
            option(value="{{ other.pk }}") v#{other.number} (#{other.status})
      button.secondary(type="submit") Compare
if generated
  section.card
    h2 Timetable
    p.muted Showing #{preview_resource.kind} #{preview_resource.code}. Pick a section, teacher or room to see its week.
    div.chips
      each link in resource_links
        a(href="{{ link.url }}" hx-get="{{ link.url }}" hx-target="#panel" hx-push-url="true") #{link.resource.kind} #{link.resource.code}
    include timetable/_grid_table.pug
elif requirements
  section.card
    h2 Timetable
    p.muted Nothing generated yet. Press Generate timetable above to build it from the requirements below.
section.card
  h2 Requirements
  p.muted One row per class to schedule: the subject, who teaches it, which section attends, and how many times a week.
  if requirements
    table
      thead
        tr
          th Subject
          th Teachers
          th Sections
          th Per week
          th Periods
          th Room type
          th Rooms
          th Fixed room
          th Fixed slots
          if editable
            th Actions
      tbody
        each row in requirements
          tr
            td= row.requirement.subject.code
            td= row.teachers
            td= row.attendees
            td= row.requirement.sessions
            td= row.requirement.length
            td= row.requirement.room_tag|default:"-"
            td= row.requirement.rooms_needed
            td= row.fixed_room|default:"-"
            td= row.fixed_slots|default:"-"
            if editable
              td
                a(href="{% url 'requirement-edit' pk=row.requirement.pk %}" hx-get="{% url 'requirement-edit' pk=row.requirement.pk %}" hx-target="#panel") Edit
                |
                form.inline(method="post" action="{% url 'requirement-delete' pk=row.requirement.pk %}" hx-post="{% url 'requirement-delete' pk=row.requirement.pk %}" hx-target="#panel")
                  - csrf_token
                  button.link(type="submit") Delete
  else
    p.muted No requirements yet. Add the first one with the form below.
if requirement_form
  section.card
    if editing
      h2 Edit requirement
    else
      h2 Add requirement
    include timetable/requirement_form.pug
