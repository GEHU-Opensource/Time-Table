section.card
  h1 Import from Excel
  p.muted The quickest way to set everything up: put your teachers, rooms, sections, subjects and requirements in one workbook and upload it. Start from the sample so the sheets and columns are right.
  p
    a.button.secondary(href="{% url 'data-sample' %}") Download sample workbook
  form.stack(method="post" action="{% url 'data-import' %}" hx-post="{% url 'data-import' %}" hx-target="#panel" hx-encoding="multipart/form-data" enctype="multipart/form-data")
    - csrf_token
    | {{ import_form.as_div }}
    div
      button(type="submit") Upload
  if plan
    if applied
      h2 Import applied
      if imported_version
        p
          a(href="{% url 'version-detail' pk=imported_version %}") Open the imported timetable
    elif plan.errors
      h2 Workbook rejected
      p.muted Nothing was saved. Fix these rows in the workbook and upload it again.
    else
      h2 Dry run passed
      p.muted Nothing was saved yet. Untick "Check only" and upload the same file again to save it.
    if plan.errors
      ul.errorlist
        each problem in plan.errors
          li= problem
    if summary
      table
        tbody
          each key, value in summary.items
            tr
              th= key
              td
                if value.items
                  each name, count in value.items
                    span.badge #{name}: #{count}
                else
                  | #{value}
if export_form
  section.card
    h2 Download a timetable as Excel
    form.row(method="post" action="{% url 'data-export' %}")
      - csrf_token
      | {{ export_form.as_div }}
      button(type="submit") Download .xlsx
