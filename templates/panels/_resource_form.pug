form.stack(method="post" action="{% if editing %}{% url 'resource-edit' pk=editing.pk %}{% else %}{% url 'resource-create' %}{% endif %}" hx-post="{% if editing %}{% url 'resource-edit' pk=editing.pk %}{% else %}{% url 'resource-create' %}{% endif %}" hx-target="#panel")
  - csrf_token
  | {{ form.non_field_errors }}
  each field in form.tucked_fields
    | {{ field.as_hidden }}
  each field in form.main_fields
    div
      | {{ field.as_field_group }}
  details(open=form.slots_open)
    summary Availability (optional): mark times that are unavailable or preferred
    h3 Unavailable slots
    | {{ form.unavailable.errors }}
    | {% include "panels/_slot_grid.pug" with name="unavailable" rows=form.unavailable_rows %}
    h3 Preferred slots
    | {{ form.preferred.errors }}
    | {% include "panels/_slot_grid.pug" with name="preferred" rows=form.preferred_rows %}
  div
    if editing
      button(type="submit") Save
      |
      a.button.secondary(href="{% url 'panel-resources' %}?kind={{ editing.kind }}" hx-get="{% url 'panel-resources' %}?kind={{ editing.kind }}" hx-target="#panel") Cancel
    else
      button(type="submit") Add #{kind}
