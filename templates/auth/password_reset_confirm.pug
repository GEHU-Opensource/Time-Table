extends layout.pug

block content
  section.card
    if validlink
      h1 Choose a new password
      form.stack(method="post")
        - csrf_token
        if form.non_field_errors
          ul.errorlist
            each e in form.non_field_errors
              li= e
        label
          | {{ form.new_password1.label }}
          | {{ form.new_password1 }}
          if form.new_password1.errors
            ul.errorlist
              each e in form.new_password1.errors
                li= e
        label
          | {{ form.new_password2.label }}
          | {{ form.new_password2 }}
          if form.new_password2.errors
            ul.errorlist
              each e in form.new_password2.errors
                li= e
        div
          button(type="submit") Change password
    else
      h1 This reset link is not valid
      p It may have expired or already been used.
      p
        a(href="{% url 'password-reset' %}") Request a new link
