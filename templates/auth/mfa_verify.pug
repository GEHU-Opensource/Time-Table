extends layout.pug

block content
  section.card
    h1 Enter your authenticator code
    form.stack(method="post" action="{% url 'mfa-verify' %}")
      - csrf_token
      if form.non_field_errors
        ul.errorlist
          each e in form.non_field_errors
            li= e
      label
        | {{ form.token.label }}
        | {{ form.token }}
        if form.token.errors
          ul.errorlist
            each e in form.token.errors
              li= e
      div
        button(type="submit") Verify
