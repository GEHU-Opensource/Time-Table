extends layout.pug

block content
  section.card
    h1 Welcome, {{ invited.name }}
    p Choose a password for {{ invited.email }} at {{ tenant.name }}.
    form.stack(method="post" action="{% url 'invite-set-password' %}")
      - csrf_token
      if form.non_field_errors
        ul.errorlist
          each e in form.non_field_errors
            li= e
      label
        | {{ form.new_password1.label }}
        | {{ form.new_password1 }}
        if form.new_password1.errors
          ul.errorlist
            each e in form.new_password1.errors
              li= e
      label
        | {{ form.new_password2.label }}
        | {{ form.new_password2 }}
        if form.new_password2.errors
          ul.errorlist
            each e in form.new_password2.errors
              li= e
      p.muted At least 12 characters, not entirely numeric, not too similar to your name or email.
      div
        button(type="submit") Set password and sign in
