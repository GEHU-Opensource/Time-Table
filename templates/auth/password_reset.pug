extends layout.pug

block content
  section.card
    h1 Reset your password
    p Enter your email address and we will send you a link to choose a new password.
    form.stack(method="post" action="{% url 'password-reset' %}")
      - csrf_token
      label
        | {{ form.email.label }}
        | {{ form.email }}
        if form.email.errors
          ul.errorlist
            each e in form.email.errors
              li= e
      div
        button(type="submit") Send reset link
    p
      a(href="{% url 'login' %}") Back to sign in
